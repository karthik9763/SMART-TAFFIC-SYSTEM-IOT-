# Copy this file to .env and fill in your local values.
SECRET_KEY=replace-with-strong-random-secret
JWT_SECRET=smart-traffic-jwt-super-secret-key-32b
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///smart_traffic.db
FLASK_DEBUG=true
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@smarttraffic.ai
BOOTSTRAP_ADMIN_PASSWORD=123456
DEVICE_OFFLINE_TIMEOUT_SECONDS=30
DEVICE_MINIMUM_INTERVAL_SECONDS=0.5
TRUSTED_DENSITY_MODEL=false
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=smart-traffic-bridge
MQTT_BROKER_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=smart-traffic-api-bridge
MQTT_API_BASE_URL=http://127.0.0.1:5000
